{
	"name": "My Site",
	"domain": "https://site.test",
	"paths": {
		"home": { "path": "/", "mask": [".hero-carousel"] },
		"blog": "/blog",
		"single-post": "/blog/single-post"
	},
	"viewports": [
		{ "name": "desktop", "width": 1920, "height": 1080 },
		{ "name": "mobile", "width": 390, "height": 844 },
		{ "name": "mobile-retina", "width": 390, "height": 844, "deviceScaleFactor": 2 }
	],
	"pixelmatchOptions": {
		"threshold": 0.1,
		"includeAA": false,
		"alpha": 0.1,
		"diffColor": [255, 0, 0]
	},
	"timeouts": {
		"goto": 15000,
		"settle": 8000
	},
	"blockHosts": ["captcha.example.com"],
	"imageCache": true,
	"mask": [".cookie-banner"],
	"browser": {
		"userAgent": "MySiteVisualCheck/1.0",
		"launchOptions": { "chromiumSandbox": true }
	},
	"stabilize": {
		"animations": "disabled",
		"reducedMotion": "reduce",
		"timezoneId": "UTC",
		"locale": "en-US"
	},
	"navigation": { "waitUntil": "networkidle" },
	"html": {
		"normalize": {
			"patterns": ["(?<=data-timestamp=\")\\d+"]
		}
	}
}
